{
	"schemaVersion": 1,
	"id": "openclient",
	"version": "${version}",
	"name": "OpenClient",
	"description": "OpenClient is an open-source Minecraft client focusing on performance, custom HUD elements, and useful utilities.",
	"authors": [
		"MrKaktusik_"
	],
	"license": "GPL-v3",
	"icon": "assets/openclient/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.cactus.OpenClient"
		]
	},
	"mixins": [
		"openclient.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}